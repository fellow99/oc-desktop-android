+/**
+ * Android (`android`) variant of `#pty`.
+ *
+ * `packages/core/package.json` maps the `android` condition here and the CLI build puts `"android"`
+ * ahead of `"node"` in `resolve.conditions`.
+ *
+ * Why not `pty.node.ts` directly: that module resolves `@lydell/node-pty` **at import time**
+ * (`const pty = createRequire(import.meta.url)(...)`). The Android payload is built for
+ * `linux-arm64`, so its node-pty copy is the linux one; anyone running that bundle on another host
+ * platform (the Windows build machine running `scripts/smoke-node26.mjs`) would abort the whole
+ * bundle import — `@lydell/node-pty-linux-arm64/lib/index.js` requires `./windowsTerminal` when
+ * `process.platform === "win32"`, and that file only exists in the win32 package. The same eager
+ * load also turns a missing/ABI-mismatched native module on the device into "server cannot start"
+ * instead of "terminal unavailable".
+ *
+ * So this variant keeps the exact `pty.node.ts` behaviour but defers the native load to the first
+ * `spawn()` call. Everything else (types, error surface) is identical; a load failure now fails the
+ * terminal that asked for it, which is the same self-gating contract the ohos stub uses.
+ */
+import { createRequire } from "node:module"
+import type { spawn as nodeSpawn } from "@lydell/node-pty"
+import type { Disp, Opts, Proc } from "./pty.js"
+
+export type { Disp, Exit, Opts, Proc } from "./pty.js"
+
+const require = createRequire(import.meta.url)
+
+let cached: { spawn: typeof nodeSpawn } | undefined
+
+function backend() {
+  if (cached) return cached
+  cached = require(process.env.OPENCODE_NODE_PTY_PATH ?? "@lydell/node-pty") as { spawn: typeof nodeSpawn }
+  return cached
+}
+
+function spawnPty(file: string, args: string[], opts: Opts): Proc {
+  const proc = backend().spawn(file, args, opts)
+  return {
+    pid: proc.pid,
+    onData(listener) {
+      return proc.onData(listener)
+    },
+    onExit(listener) {
+      return proc.onExit(listener)
+    },
+    write(data) {
+      proc.write(data)
+    },
+    resize(cols, rows) {
+      proc.resize(cols, rows)
+    },
+    kill(signal) {
+      proc.kill(signal)
+    },
+  }
+}
+
+export { spawnPty as spawn }
