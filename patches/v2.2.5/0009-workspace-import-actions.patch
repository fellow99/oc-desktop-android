+
+// ------------------------------------------------------------------ Android 沙箱动作（203 R1/R2/R4；能力由 oc-plugin-workspace-roots 提供）
+
+export type ActionResult = { readonly ok: boolean; readonly code: string; readonly message: string }
+
+function asActionResult(r: Record<string, unknown>): ActionResult {
+  return {
+    ok: r.ok === true,
+    code: typeof r.code === "string" ? r.code : "",
+    message: typeof r.message === "string" ? r.message : "",
+  }
+}
+
+/** SAF 导入：发起后返回轮询 token */
+export async function importSandboxTree(
+  sdk: RpcSdk,
+  suggestedName: string,
+): Promise<ActionResult & { token?: string; name?: string }> {
+  try {
+    const output = (
+      await sdk.api.rpc.call({ rpcID: ROOTS_RPC_ID, method: "import", input: { suggestedName } })
+    ).output
+    const r = (output ?? {}) as Record<string, unknown>
+    return {
+      ...asActionResult(r),
+      token: typeof r.token === "string" ? r.token : undefined,
+      name: typeof r.name === "string" ? r.name : undefined,
+    }
+  } catch (error) {
+    return { ok: false, code: "call-failed", message: error instanceof Error ? error.message : String(error) }
+  }
+}
+
+export type ImportStatus = ActionResult & {
+  done?: boolean
+  canceled?: boolean
+  copiedFiles?: number
+  importedTo?: string
+  name?: string
+  error?: string
+}
+
+/** SAF 导入进度轮询 */
+export async function importStatusOf(sdk: RpcSdk, token: string): Promise<ImportStatus> {
+  try {
+    const output = (
+      await sdk.api.rpc.call({ rpcID: ROOTS_RPC_ID, method: "importStatus", input: { token } })
+    ).output
+    const r = (output ?? {}) as Record<string, unknown>
+    return {
+      ...asActionResult(r),
+      done: r.done === true,
+      canceled: r.canceled === true,
+      copiedFiles: typeof r.copiedFiles === "number" ? r.copiedFiles : 0,
+      importedTo: typeof r.importedTo === "string" ? r.importedTo : undefined,
+      name: typeof r.name === "string" ? r.name : undefined,
+      error: typeof r.error === "string" ? r.error : undefined,
+    }
+  } catch (error) {
+    return { ok: false, code: "call-failed", message: error instanceof Error ? error.message : String(error) }
+  }
+}
+
+/** 取消进行中的 SAF 导入 */
+export async function importCancelOf(sdk: RpcSdk, token: string): Promise<ActionResult> {
+  try {
+    const output = (
+      await sdk.api.rpc.call({ rpcID: ROOTS_RPC_ID, method: "importCancel", input: { token } })
+    ).output
+    return asActionResult((output ?? {}) as Record<string, unknown>)
+  } catch (error) {
+    return { ok: false, code: "call-failed", message: error instanceof Error ? error.message : String(error) }
+  }
+}
+
+/** 删除沙箱下指定项目目录（第一段） */
+export async function removeSandboxProject(sdk: RpcSdk, name: string): Promise<ActionResult> {
+  try {
+    const output = (await sdk.api.rpc.call({ rpcID: ROOTS_RPC_ID, method: "remove", input: { name } })).output
+    return asActionResult((output ?? {}) as Record<string, unknown>)
+  } catch (error) {
+    return { ok: false, code: "call-failed", message: error instanceof Error ? error.message : String(error) }
+  }
+}
+
+/** 把指定项目设为启动默认工作区 */
+export async function setCurrentProject(sdk: RpcSdk, name: string): Promise<ActionResult> {
+  try {
+    const output = (
+      await sdk.api.rpc.call({ rpcID: ROOTS_RPC_ID, method: "setCurrent", input: { name } })
+    ).output
+    return asActionResult((output ?? {}) as Record<string, unknown>)
+  } catch (error) {
+    return { ok: false, code: "call-failed", message: error instanceof Error ? error.message : String(error) }
+  }
+}
