diff --git a/packages/app/src/runtime/android/back.ts b/packages/app/src/runtime/android/back.ts
new file mode 100644
index 0000000000..8fda43c679
--- /dev/null
+++ b/packages/app/src/runtime/android/back.ts
@@ -0,0 +1,75 @@
+// Android 硬件返回接线（v2.2.5 补丁 0011）。
+//
+// 宿主在硬件返回时 evaluateJavascript("window.__ocAndroidBack()")。Web 侧按优先级消费：
+//   1. 打开的移动抽屉/弹层（corvu）→ 关闭
+//   2. 后注册者优先的命名处理器（设置退出 → 会话子视图回“会话”tab）
+//   3. 都不消费 → 返回 false：首页 / 会话 tab 上不做任何操作
+//
+// 桌面与普通浏览器从不调用 window.__ocAndroidBack，故本模块零副作用、不引入平台分支。
+// 通信为单向（宿主→网页），不使用 @JavascriptInterface，无反射面。
+
+/** 返回处理器：返回 true 表示已消费（宿主不退出）；false 表示交给下一个处理器。 */
+export type AndroidBackHandler = () => boolean
+
+const handlers = new Set<AndroidBackHandler>()
+
+/**
+ * 注册返回处理器。后注册者先执行（更靠近当前界面的视图优先，如会话/设置覆盖在外壳之上）。
+ * 返回注销函数，组件卸载时调用。
+ */
+export function registerAndroidBackHandler(handler: AndroidBackHandler): () => void {
+  handlers.add(handler)
+  return () => handlers.delete(handler)
+}
+
+/** corvu 移动抽屉/弹层的可见遮罩；存在即代表有打开的浮层。 */
+function openOverlays(): Element[] {
+  return Array.from(
+    document.querySelectorAll<HTMLElement>(
+      '[data-slot="mobile-drawer-overlay"], [data-slot="mobile-panel"] [data-corvu-overlay]',
+    ),
+  ).filter((el) => el.offsetParent !== null || el.getClientRects().length > 0)
+}
+
+/** 关闭打开的移动抽屉/弹层。优先点遮罩（corvu 标准关闭路径），必要时补发 Escape。 */
+function closeOpenOverlay(): boolean {
+  const overlay = openOverlays()[0]
+  if (!overlay) return false
+
+  const target = overlay as HTMLElement
+  const rect = target.getBoundingClientRect()
+  const x = rect.left + rect.width / 2
+  const y = rect.top + rect.height / 2
+  const opts = { bubbles: true, cancelable: true, clientX: x, clientY: y, button: 0 } as const
+  target.dispatchEvent(new PointerEvent("pointerdown", opts))
+  target.dispatchEvent(new MouseEvent("mousedown", opts))
+  target.dispatchEvent(new PointerEvent("pointerup", opts))
+  target.dispatchEvent(new MouseEvent("mouseup", opts))
+  target.dispatchEvent(new MouseEvent("click", opts))
+
+  // 遮罩可能因实现差异不响应合成点击：兜底发 Escape（corvu 默认 onEscapeKeyDown 关闭）。
+  if (openOverlays().length > 0) {
+    document.dispatchEvent(new KeyboardEvent("keydown", { key: "Escape", code: "Escape", bubbles: true }))
+  }
+  return true
+}
+
+/** 宿主入口：返回是否已消费。务必同步，且不依赖 React/Solid 之外的时序。 */
+function dispatchAndroidBack(): boolean {
+  if (closeOpenOverlay()) return true
+  // 后注册者先消费
+  for (const handler of Array.from(handlers).reverse()) {
+    try {
+      if (handler()) return true
+    } catch {
+      // 单个处理器异常不应阻断后续处理器
+    }
+  }
+  return false
+}
+
+export function installAndroidBack() {
+  if (typeof window === "undefined") return
+  const w = window as unknown as { __ocAndroidBack?: () => boolean }
+  w.__ocAndroidBack = dispatchAndroidBack
+}
