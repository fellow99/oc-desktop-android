+
+// ------------------------------------------------------------------ Android 动作（203 R1/R2/R4；能力由 oc-plugin-workspace-roots 提供）
+export type ActionResult = { readonly ok: boolean; readonly code: string; readonly message: string }
+
+export async function importSandboxTree(sdk: RpcSdk, suggestedName: string): Promise<ActionResult & { token?: string; name?: string }> {
+  try {
+    const output = (await sdk.api.rpc.call({ rpcID: ROOTS_RPC_ID, method: "import", input: { suggestedName } })).output
+    const r = (output ?? {}) as Record<string, unknown>
+    return { ok: r.ok === true, code: typeof r.code === "string" ? r.code : "", message: typeof r.message === "string" ? r.message : "", token: typeof r.token === "string" ? r.token : undefined, name: typeof r.name === "string" ? r.name : undefined }
+  } catch (error) {
+    return { ok: false, code: "call-failed", message: error instanceof Error ? error.message : String(error) }
+  }
+}
+
+export async function importStatusOf(sdk: RpcSdk, token: string): Promise<ActionResult & { done?: boolean; canceled?: boolean; copiedFiles?: number; copiedBytes?: number; importedTo?: string; name?: string; error?: string }> {
+  try {
+    const output = (await sdk.api.rpc.call({ rpcID: ROOTS_RPC_ID, method: "importStatus", input: { token } })).output
+    const r = (output ?? {}) as Record<string, unknown>
+    return { ok: r.ok === true, code: typeof r.code === "string" ? r.code : "", message: typeof r.message === "string" ? r.message : "", done: r.done === true, canceled: r.canceled === true, copiedFiles: typeof r.copiedFiles === "number" ? r.copiedFiles : 0, copiedBytes: typeof r.copiedBytes === "number" ? r.copiedBytes : 0, importedTo: typeof r.importedTo === "string" ? r.importedTo : undefined, name: typeof r.name === "string" ? r.name : undefined, error: typeof r.error === "string" ? r.error : undefined }
+  } catch (error) {
+    return { ok: false, code: "call-failed", message: error instanceof Error ? error.message : String(error) }
+  }
+}
+
+export async function removeSandboxProject(sdk: RpcSdk, name: string): Promise<ActionResult> {
+  try {
+    const output = (await sdk.api.rpc.call({ rpcID: ROOTS_RPC_ID, method: "remove", input: { name } })).output
+    const r = (output ?? {}) as Record<string, unknown>
+    return { ok: r.ok === true, code: typeof r.code === "string" ? r.code : "", message: typeof r.message === "string" ? r.message : "" }
+  } catch (error) {
+    return { ok: false, code: "call-failed", message: error instanceof Error ? error.message : String(error) }
+  }
+}
